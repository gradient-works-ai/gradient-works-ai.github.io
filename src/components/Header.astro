---
import { nav } from '../data/site';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const home = path === '/';
---

<header class="hdr" id="hdr">
  <nav class="bar glass" aria-label="Main" data-liquid>
    <a class="brand" href={home ? '#top' : '/'} data-scroll={home || undefined}><Logo id="logo-hdr" size={19} /> Gradient Works</a>
    <ul class="links">
      {nav.filter((n) => n.href !== '/contact/').map((n) => <li><a href={n.href} class={path.startsWith(n.href) ? 'on' : undefined} aria-current={path.startsWith(n.href) ? 'page' : undefined} data-scramble>{n.label}</a></li>)}
    </ul>
    <div class="right">
      <button class="kbd" id="paletteBtn" aria-label="Open command menu" aria-haspopup="dialog">
        <span class="mono only-wide">⌘K</span><span class="mono only-narrow">Menu</span>
      </button>
      <a class="btn btn-light btn-sm only-wide" href="/contact/">Start a project</a>
    </div>
  </nav>
</header>

<style>
  .hdr { position: fixed; z-index: 50; top: 16px; left: 0; right: 0; display: flex; justify-content: center; padding: 0 16px; transition: transform .7s var(--ease); }
  .hdr:global(.hide) { transform: translateY(-140%); }
  /* Liquid glass (macOS Control Center style): bright translucent fill, heavy blur + saturation,
     a specular rim that's brightest top-left, and an inner top highlight. */
  /* the transition name lives on the bar itself: on .hdr it would make the wrapper a backdrop root and blank the glass */
  .bar { view-transition-name: site-header; position: relative; width: 100%; max-width: 1080px; height: 62px; padding: 0 9px 0 22px; border-radius: 40px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 24px;
    background: linear-gradient(180deg, rgba(255, 255, 255, .13), rgba(255, 255, 255, .05) 55%, rgba(255, 255, 255, .07));
    backdrop-filter: blur(26px) saturate(190%) brightness(1.08); -webkit-backdrop-filter: blur(26px) saturate(190%) brightness(1.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .32), inset 0 -1px 0 rgba(255, 255, 255, .06), inset 0 0 22px rgba(255, 255, 255, .05), 0 12px 40px -14px rgba(0, 0, 0, .65);
    transition: background .5s var(--ease), box-shadow .5s var(--ease); }
  .bar::before { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
    background: linear-gradient(135deg, rgba(255, 255, 255, .55), rgba(255, 255, 255, .1) 32%, rgba(255, 255, 255, .03) 60%, rgba(255, 255, 255, .28));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; }
  .bar:global(.liquid) {
    background: linear-gradient(180deg, rgba(255, 255, 255, .06), rgba(255, 255, 255, .02) 60%, rgba(255, 255, 255, .04));
    box-shadow:
      inset 1.5px 1.5px 1px -1px rgba(255, 255, 255, .75),      /* bright specular top-left edge */
      inset -1px -1px 1px -0.5px rgba(255, 255, 255, .28),      /* softer bottom-right edge */
      inset 0 0 0 1px rgba(255, 255, 255, .1),
      inset 0 -10px 18px -12px rgba(255, 255, 255, .12),        /* light gathering at the lower rim */
      0 10px 30px -10px rgba(0, 0, 0, .55), 0 2px 6px -2px rgba(0, 0, 0, .4);
  }
  .bar:global(.liquid)::before { opacity: .45; }
  .hdr:global(.scrolled) .bar:global(.liquid) { background: linear-gradient(180deg, rgba(255, 255, 255, .07), rgba(255, 255, 255, .03) 60%, rgba(255, 255, 255, .05)); }
  .hdr:global(.scrolled) .bar { background: linear-gradient(180deg, rgba(255, 255, 255, .15), rgba(255, 255, 255, .07) 55%, rgba(255, 255, 255, .09)); }
  .brand { font-size: 18px; letter-spacing: -.04em; display: flex; gap: 10px; align-items: center; }
  .links { display: flex; justify-content: center; gap: 4px; font-size: 14px; color: rgba(243, 241, 236, .72); }
  /* nav items are glass pills inside the bar: faint on hover, lit when current */
  .links a { display: inline-block; padding: 8px 15px; border-radius: 30px; transition: color .3s, background .3s, box-shadow .3s; }
  .links a:hover { color: var(--text); background: rgba(255, 255, 255, .08); }
  .links a.on { color: var(--text); background: rgba(255, 255, 255, .14); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .22), inset 0 0 0 1px rgba(255, 255, 255, .08); }
  .right { display: flex; gap: 8px; align-items: center; }
  .kbd { height: 44px; min-width: 44px; padding: 0 14px; border-radius: 30px; color: rgba(243, 241, 236, .8);
    background: rgba(255, 255, 255, .08); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .22), inset 0 0 0 1px rgba(255, 255, 255, .1);
    transition: color .3s, background .3s; }
  .kbd:hover { color: var(--text); background: rgba(255, 255, 255, .15); }
  .right :global(.btn-light) { height: 44px; box-shadow: inset 0 -1px 0 rgba(0, 0, 0, .12), 0 4px 18px -6px rgba(243, 241, 236, .35); }
  .only-narrow { display: none; }
  @media (max-width: 900px) {
    .links, .only-wide { display: none; }
    .only-narrow { display: inline; }
    .bar { grid-template-columns: 1fr auto; height: 54px; }
  }
</style>
