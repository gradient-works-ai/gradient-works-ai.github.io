---
import { nav } from '../data/site';
---

<section class="section explore" aria-label="Explore">
  <div class="wrap">
    <p class="eyebrow mono" data-reveal>Explore</p>
    <ul class="rows">
      {nav.map((n, i) => (
        <li data-reveal>
          <a href={n.href}>
            <span class="idx mono">0{i + 1}</span>
            <span class="label">{n.label}</span>
            <span class="teaser">{n.teaser}</span>
            <pre class="glyph" aria-hidden="true">{n.glyph}</pre>
            <span class="go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .explore { padding-top: 120px; }
  .rows { border-top: 1px solid var(--line); }
  .rows li { border-bottom: 1px solid var(--line); }
  .rows a { position: relative; display: grid; grid-template-columns: 64px minmax(0, 1.1fr) minmax(0, 1fr) 120px 48px; align-items: center; gap: 24px; padding: 34px 8px;
    transition: padding .6s var(--ease); }
  .rows a::before { content: ""; position: absolute; inset: 0; border-radius: 16px; background: var(--glass); opacity: 0; transform: scaleY(.6); transition: opacity .5s var(--ease), transform .6s var(--ease); }
  .rows a:hover { padding-left: 24px; padding-right: 24px; }
  .rows a:hover::before { opacity: 1; transform: none; }
  .rows a > * { position: relative; }
  .idx { color: var(--faint); font-size: 11px; }
  .label { font-size: clamp(32px, 4.4vw, 64px); letter-spacing: -.055em; line-height: 1; transition: color .4s; }
  .teaser { color: var(--mute); font-size: 16px; max-width: 340px; }
  .glyph { font: 11px/1.25 var(--mono); color: var(--faint); justify-self: end; opacity: 0; transform: translateX(-10px); transition: opacity .5s var(--ease), transform .5s var(--ease), color .4s; }
  .go { justify-self: end; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; box-shadow: inset 0 0 0 1px var(--line); color: var(--mute);
    transition: background .4s var(--ease), color .4s, transform .5s var(--ease); }
  .rows a:hover .glyph { opacity: 1; transform: none; color: var(--mute); }
  .rows a:hover .go { background: var(--text); color: var(--bg); transform: rotate(-45deg); }
  @media (max-width: 900px) {
    .rows a { grid-template-columns: 40px 1fr 44px; gap: 6px 16px; padding: 26px 4px; }
    .teaser { grid-column: 2; grid-row: 2; font-size: 15px; }
    .glyph { display: none; }
    .go { grid-column: 3; grid-row: 1 / span 2; }
  }
</style>
