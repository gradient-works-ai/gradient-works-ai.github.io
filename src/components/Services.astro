---
import { services } from '../data/site';
---

<section class="section" id="services">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow mono">Services</p>
        <h2 data-split>Four disciplines,<br />one standard of rigour.</h2>
      </div>
      <p class="head-side" data-reveal>We design, train and test machine learning models for startups, research labs and small teams. Every engagement has a defined metric and a written result.</p>
    </div>
    <div class="cards">
      {services.map((s, i) => (
        <article class="card glass" data-tilt data-reveal>
          <div class="top">
            <span class="mono num">0{i + 1}</span>
            <pre class="glyph" aria-hidden="true">{s.glyph}</pre>
          </div>
          <div>
            <h3>{s.title}</h3>
            <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; perspective: 1200px; }
  .card { padding: 28px; min-height: 400px; display: flex; flex-direction: column; justify-content: space-between; }
  .top { display: flex; justify-content: space-between; align-items: flex-start; }
  .num { color: var(--faint); font-size: 11px; }
  .glyph { font: 12px/1.2 var(--mono); color: var(--faint); text-align: right; transition: color .5s var(--ease); }
  .card:hover .glyph { color: var(--text); }
  h3 { margin-bottom: 18px; }
  li { padding: 9px 0; font-size: 15px; color: var(--mute); border-top: 1px solid var(--line); }
  @media (max-width: 1100px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .cards { grid-template-columns: 1fr; } .card { min-height: 0; gap: 48px; } }
</style>
