---
import { steps } from '../data/site';
---

<section class="section" id="process">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow mono">Process</p>
        <h1 class="page-title" data-split>From hypothesis<br />to handover.</h1>
      </div>
      <p class="head-side" data-reveal>Every project runs the same loop: define the metric, beat a baseline, test on data the model has never seen, then hand over everything. Here's a typical four-week sprint.</p>
    </div>

    <div class="proc">
      <!-- Sticky on desktop; on phones it collapses to a compact terminal that follows the steps. -->
      <div class="sticky">
        <div class="panel glass">
          <div class="viz"><canvas class="ascii" id="aLand" data-fill="height" aria-hidden="true"></canvas></div>
          <div class="term">
            <div class="term-top mono"><span>example-engagement — gw</span><span id="termStep">01 / 0{steps.length}</span></div>
            <pre id="term" aria-label="Example engagement terminal output"></pre>
          </div>
        </div>
        <p class="fig mono"><b>Fig. 01</b> — Momentum SGD on a non-convex loss surface · <span id="landStat">step 0000</span></p>
      </div>

      <div class="steps">
      <span class="rail" aria-hidden="true"><span id="rail"></span></span>
      <ol id="steps">
        {steps.map((s, i) => (
          <li class={`step${i === 0 ? ' active' : ''}`}>
            <p class="meta mono"><span class="dot"></span>0{i + 1} — {s.when}</p>
            <h2 class="step-title">{s.title}</h2>
            <p class="body">{s.body}</p>
            <ul class="gives">{s.gives.map((g) => <li class="mono">{g}</li>)}</ul>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </div>
  <script type="application/json" id="stepsData" set:html={JSON.stringify(steps)} />
</section>

<style>
  .proc { display: grid; grid-template-columns: 1.05fr 1fr; gap: 72px; align-items: start; }
  .sticky { position: sticky; top: 96px; }
  .panel { height: min(calc(100svh - 150px), 780px); min-height: 460px; display: flex; flex-direction: column; overflow: hidden; }
  .viz { flex: 1; min-height: 0; display: grid; place-items: center; padding: 18px; overflow: hidden; }
  .term { flex: none; border-top: 1px solid var(--line); background: rgba(8, 8, 6, .55); }
  .term-top { display: flex; justify-content: space-between; padding: 12px 18px; border-bottom: 1px solid var(--line); color: var(--faint); font-size: 10px; }
  #term { padding: 14px 18px; height: 196px; overflow: hidden; font: 12px/1.7 var(--mono); color: var(--mute); white-space: pre-wrap; }
  #term :global(.cmd) { color: var(--text); }
  #term :global(.cmd)::before { content: "$ "; color: var(--faint); }
  #term :global(.warn) { color: #f4c58f; }
  #term :global(.caret) { display: inline-block; width: .6em; height: 1.1em; background: var(--text); vertical-align: -.2em; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .steps { position: relative; padding-left: 36px; }
  .rail { position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: var(--line); }
  .rail span { position: absolute; inset: 0; background: var(--iri); transform-origin: top; transform: scaleY(0); }
  .step { padding: 14vh 0; min-height: 52vh; display: flex; flex-direction: column; justify-content: center; }
  .step:first-child { padding-top: 4vh; }
  .step:last-child { padding-bottom: 6vh; }
  .meta { display: flex; align-items: center; gap: 12px; color: var(--faint); font-size: 11px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; margin-left: -41px; margin-right: 20px; background: var(--bg); box-shadow: inset 0 0 0 1px var(--faint); transition: all .5s var(--ease); }
  .step:global(.active) .dot { background: #f3f1ec; box-shadow: 0 0 0 5px rgba(243, 241, 236, .1); }
  .step .step-title { font-size: clamp(32px, 3.4vw, 48px); letter-spacing: -.05em; margin: 14px 0 14px; line-height: 1.05; color: var(--mute); transition: color .5s var(--ease); }
  .step:global(.active) .step-title, :global(html:not(.motion)) .step .step-title { color: var(--text); }
  .body { font-size: 18px; max-width: 470px; color: var(--mute); }
  .gives { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .gives li { padding: 8px 12px; border-radius: 30px; font-size: 10px; color: var(--mute); background: var(--glass); box-shadow: inset 0 0 0 1px var(--line); }

  @media (max-width: 1000px) {
    .proc { grid-template-columns: 1fr; gap: 24px; }
    .sticky { top: 84px; z-index: 2; }
    .panel { height: auto; min-height: 0; }
    .viz, .fig { display: none; }
    .term { border-top: 0; }
    #term { height: 132px; font-size: 11px; }
    .step { min-height: 0; padding: 9vh 0; }
    .steps { padding-left: 28px; }
    .dot { margin-left: -33px; margin-right: 12px; }
  }
</style>
