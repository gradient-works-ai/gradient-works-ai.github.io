---
import { steps } from '../data/site';
---

<section class="section" id="process">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow mono">02 — Process</p>
        <h2 data-split>From hypothesis<br />to handover.</h2>
      </div>
      <p class="head-side" data-reveal>Every project runs the same loop: define the metric, beat a baseline, test on data the model has never seen, then hand over everything. Scroll through an example engagement.</p>
    </div>

    <div class="proc" id="procPin">
      <div class="left">
        <div class="panel glass"><pre class="ascii" id="aLand" data-cols="84" aria-hidden="true"></pre></div>
        <p class="fig mono"><b>Fig. 01</b> — Momentum SGD on a non-convex loss surface · <span id="landStat">step 0000</span></p>
      </div>

      <div class="right">
        <ol class="steps" id="steps">
          {steps.map((s, i) => (
            <li class={i === 0 ? 'active' : ''}>
              <span class="mono idx">0{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <div class="body"><p>{s.body}</p></div>
              </div>
            </li>
          ))}
          <span class="rail" aria-hidden="true"><span id="rail"></span></span>
        </ol>
        <div class="term">
          <div class="term-top mono"><span>example-engagement — gw</span><span id="termStep">1/{steps.length}</span></div>
          <pre id="term" aria-label="Example engagement terminal output"></pre>
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" id="stepsData" set:html={JSON.stringify(steps)} />
</section>

<style>
  .proc { display: grid; grid-template-columns: 1.1fr 1fr; gap: 20px; align-items: start; }
  .panel { padding: 22px; overflow: hidden; }
  .steps { position: relative; padding-left: 22px; margin-bottom: 20px; }
  .rail { position: absolute; left: 0; top: 6px; bottom: 6px; width: 1px; background: var(--line); }
  .rail span { position: absolute; inset: 0; background: var(--iri); transform-origin: top; transform: scaleY(0); }
  .steps li { display: grid; grid-template-columns: 40px 1fr; padding: 12px 0; color: var(--faint); transition: color .5s var(--ease); }
  .steps li:global(.active) { color: var(--text); }
  .idx { padding-top: 6px; font-size: 11px; }
  .steps h3 { font-size: 22px; }
  .body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .6s var(--ease); }
  .body p { overflow: hidden; max-width: 440px; }
  .steps li:global(.active) .body { grid-template-rows: 1fr; }
  .steps li:global(.active) .body p { padding-top: 8px; }
  .term { border-radius: var(--radius); background: rgba(8, 8, 6, .72); box-shadow: inset 0 0 0 1px var(--line); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); overflow: hidden; }
  .term-top { display: flex; justify-content: space-between; padding: 14px 18px; border-bottom: 1px solid var(--line); color: var(--faint); font-size: 10px; }
  #term { padding: 18px; height: 250px; overflow: hidden; font: 12.5px/1.75 var(--mono); color: var(--mute); white-space: pre-wrap; }
  #term :global(.cmd) { color: var(--text); }
  #term :global(.cmd)::before { content: "$ "; color: var(--faint); }
  #term :global(.warn) { color: #f4c58f; }
  #term :global(.caret) { display: inline-block; width: .6em; height: 1.1em; background: var(--text); vertical-align: -.2em; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 1000px) {
    .proc { grid-template-columns: 1fr; }
    .steps li { color: var(--mute); }
    .body { grid-template-rows: 1fr; }
    .body p { padding-top: 8px; }
    #term { font-size: 11.5px; }
  }
</style>
