---
import { lab, site } from '../data/site';
---

<section class="section" id="lab">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow mono">03 — Lab</p>
        <h2 data-split>A research lab that<br />ships its own models.</h2>
      </div>
      <div class="head-side" data-reveal>
        <p>Between client work we build open models and tools. Each one lives in its own repository, with code, weights and evaluation results you can check yourself.</p>
        <a class="btn btn-glass btn-sm gh" href={site.github} target="_blank" rel="noopener" data-magnetic>GitHub <span class="arrow">↗</span></a>
      </div>
    </div>
    <div class="work">
      {lab.map((m) => (
        <a class="item" href={m.href} target="_blank" rel="noopener" data-reveal data-cursor="View repo">
          <div class="media glass" data-tilt><pre class="ascii" id={m.art} data-cols="64" data-fit=".74" aria-hidden="true"></pre></div>
          <div class="meta"><h3>{m.name}</h3><span class="mono">{m.meta}</span></div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .gh { margin-top: 24px; }
  .work { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; perspective: 1400px; }
  .media { aspect-ratio: 16 / 10; display: grid; place-items: center; overflow: hidden; }
  .media pre { transition: transform 1.2s var(--ease); }
  .item:hover .media pre { transform: scale(1.05); }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-top: 18px; }
  .meta h3 { font-size: 19px; }
  .meta .mono { color: var(--faint); font-size: 10px; text-align: right; }
  @media (max-width: 800px) { .work { grid-template-columns: 1fr; gap: 40px; } }
</style>
