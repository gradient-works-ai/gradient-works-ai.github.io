---
import { site, mailto } from '../data/site';
---

<section class="section" id="contact">
  <div class="wrap">
    <div class="cta glass" data-reveal>
      <pre class="bg-art" aria-hidden="true">{String.raw`  ∂L          ∂L          ∂L          ∂L
θ ← θ − η ──   θ ← θ − η ──   θ ← θ − η ──   θ ← θ − η ──
              ∂θ          ∂θ          ∂θ          ∂θ`}</pre>
      <p class="eyebrow mono">07 — Contact</p>
      <h2 class="title" data-split>Let's build something <span class="iri">rigorous.</span></h2>
      <p class="sub">Share a few lines about your problem and your data. We'll reply within 48 hours with an honest assessment of fit.</p>
      <div class="ctas">
        <a class="btn btn-light" href={mailto} data-magnetic>Email us <span class="arrow">→</span></a>
        <button class="btn btn-glass copy" id="copyEmail" data-email={site.email} data-magnetic>
          <span class="mono addr">{site.email}</span><span class="mono state" id="copyState">Copy</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding: clamp(40px, 8vw, 110px); text-align: center; overflow: hidden; border-radius: 32px; }
  .cta .eyebrow { justify-content: center; }
  .bg-art { position: absolute; inset: 0; display: grid; place-items: center; font: 14px/1.3 var(--mono); color: rgba(243, 241, 236, .04); pointer-events: none; white-space: pre; }
  .title { font-size: clamp(42px, 7vw, 104px); letter-spacing: -.06em; line-height: 1; max-width: 900px; margin: 0 auto; }
  .sub { max-width: 500px; margin: 28px auto 40px; font-size: 17px; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .copy { gap: 14px; }
  .addr { text-transform: none; font-size: 12px; color: var(--mute); }
  .state { font-size: 10px; padding: 5px 8px; border-radius: 12px; box-shadow: inset 0 0 0 1px var(--line); }
  @media (max-width: 520px) { .addr { display: none; } }
</style>
