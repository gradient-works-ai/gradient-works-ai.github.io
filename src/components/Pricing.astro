---
import { plans } from '../data/site';
---

<section class="section" id="pricing">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow mono">Pricing</p>
        <h1 class="page-title" data-split>Clear pricing, and<br />two ways to work.</h1>
      </div>
      <p class="head-side" data-reveal>A fixed scope and a fixed price. If it turns out to be bigger, we'll tell you before we start, not after.</p>
    </div>
    <div class="plans">
      {plans.map((p) => (
        <article class={`plan glass${p.featured ? ' featured' : ''}`} data-tilt data-reveal>
          <div class="row">
            <div><h2 class="t3">{p.name}</h2><p>{p.tagline}</p></div>
          </div>
          <p class="price">{p.price} <small>{p.unit}</small></p>
          <ul>{p.items.map((it) => <li><span class="mono">[x]</span>{it}</li>)}</ul>
          <a class={`btn ${p.featured ? 'btn-light' : 'btn-glass'}`} href="/contact/">{p.cta} <span class="arrow">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .plans { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; perspective: 1400px; }
  .plan { padding: 40px; display: flex; flex-direction: column; gap: 32px; }
  /* animated iridescent rim on the featured plan */
  .featured::before { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
    background: conic-gradient(from var(--a, 0deg), #f4c58f, #e8a3c9, #9fb6ff, #8ee6d1, #f4c58f);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
    animation: spin 8s linear infinite; opacity: .7; }
  @property --a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  @keyframes spin { to { --a: 360deg; } }
  .row { display: flex; justify-content: space-between; gap: 16px; }
  .row p { margin-top: 4px; }
  .tag { height: fit-content; padding: 7px 11px; border-radius: 20px; font-size: 10px; box-shadow: inset 0 0 0 1px var(--line); color: var(--text); }
  .price { font-size: clamp(48px, 5vw, 64px); letter-spacing: -.06em; color: var(--text); line-height: 1; }
  .price small { font-size: 15px; letter-spacing: -.01em; color: var(--faint); }
  ul { display: grid; gap: 12px; }
  li { display: flex; gap: 12px; color: var(--mute); }
  li .mono { color: var(--faint); padding-top: 4px; }
  .plan .btn { align-self: flex-start; margin-top: auto; }
  @media (max-width: 800px) { .plans { grid-template-columns: 1fr; } .plan { padding: 28px; } }
</style>
