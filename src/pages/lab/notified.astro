---
import Page from '../../layouts/Page.astro';
---

<Page title="You're on the list" description="We'll email you when the model ships." class="thanks" noindex>
  <section class="wrap">
    <pre class="tick" aria-hidden="true">{String.raw`   ╭─────╮
   │  ✓  │
   ╰─────╯`}</pre>
    <h1>You're on the list.</h1>
    <p>We'll send one email when the model and its evaluation report are public. Nothing else.</p>
    <a class="btn btn-light" href="/lab/">Back to the lab <span class="arrow">→</span></a>
  </section>
</Page>

<style>
  :global(main.thanks) { min-height: 100svh; display: grid; place-items: center; text-align: center; padding: 140px 0 80px; }
  .tick { font: 16px/1.2 var(--mono); color: #8ee6d1; }
  h1 { font-size: clamp(40px, 5vw, 64px); letter-spacing: -.05em; margin: 20px 0 14px; }
  p { max-width: 440px; margin: 0 auto 32px; }
</style>
