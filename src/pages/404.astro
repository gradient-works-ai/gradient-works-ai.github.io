---
import Page from '../layouts/Page.astro';
import { nav } from '../data/site';
---

<Page title="Page not found" description="This page doesn't exist." class="nf">
  <section class="wrap">
    <pre class="art" aria-hidden="true">{String.raw`  loss
   │╲
   │ ╲      ╭─╮
   │  ╲    ╱   ╲         ╭──── you are here
   │   ╰──╯     ╲       ╱
   │             ╰─────●
   └──────────────────────────── epoch`}</pre>
    <p class="code mono">Error 404</p>
    <h1>This page didn't converge.</h1>
    <p class="lede">The link may be old or mistyped. Here's where you can go instead.</p>
    <div class="ctas">
      <a class="btn btn-light" href="/">Back to home <span class="arrow">→</span></a>
      <a class="btn btn-glass" href="/contact/">Start a project</a>
    </div>
    <ul class="links mono">{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
  </section>
</Page>

<style>
  :global(main.nf) { min-height: 100svh; display: grid; place-items: center; text-align: center; padding: 140px 0 80px; }
  .art { display: inline-block; text-align: left; font: clamp(9px, 1.3vw, 13px)/1.35 var(--mono); color: var(--faint); margin-bottom: 36px; }
  .code { color: #f4c58f; font-size: 13px; }
  h1 { font-size: clamp(40px, 6vw, 80px); letter-spacing: -.055em; line-height: 1.02; margin: 18px 0 16px; }
  .lede { max-width: 440px; margin: 0 auto; font-size: 17px; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 34px; }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 10px; margin-top: 40px; font-size: 13px; }
  .links a { display: inline-block; padding: 12px 14px; color: var(--mute); transition: color .3s; }   /* 44px+ tap targets */
  .links a:hover { color: var(--text); }
</style>
