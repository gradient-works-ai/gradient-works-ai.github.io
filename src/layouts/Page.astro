---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Palette from '../components/Palette.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const { title, description, class: cls } = Astro.props;
---

<Base title={title ? `${title} · ${site.name}` : undefined} description={description}>
  <slot name="before" />
  <Header />
  <Palette />
  <main class={cls}>
    <slot />
  </main>
  <Footer />
</Base>
