---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import { site, founder, services } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} — Applied AI research & model engineering`, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// Structured data so search engines know who runs the studio and what it offers.
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  alternateName: ['Gradient Works AI', 'gradientworksai.in'],
  url: Astro.site?.href,
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: Astro.site?.href,
  description: site.description,
  email: site.email,
  logo: new URL('/icon-512.png', Astro.site).href,
  image: ogImage.href,
  areaServed: 'Worldwide',
  address: { '@type': 'PostalAddress', addressLocality: 'Bangalore', addressCountry: 'IN' },
  knowsAbout: services.map((s) => s.title),
  founder: {
    '@type': 'Person',
    name: founder.name,
    jobTitle: founder.role,
    url: new URL('/founder/', Astro.site).href,
    sameAs: founder.links.map((l) => l.href),
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Amrita School of Engineering' },
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />
    <meta name="theme-color" content="#060608" />
    <link rel="canonical" href={canonical} />
    <!-- Search results need a square raster icon of 48px or more; browsers prefer the SVG. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-96.png" sizes="96x96" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gradient Works: machine learning models, built, tested and measured properly." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Motion states only apply when JS runs and the viewer hasn't asked for reduced motion. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
  </head>
  <body>
    <canvas id="bg" aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
